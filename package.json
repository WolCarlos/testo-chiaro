{
  "name": "wol-edit-text",
  "version": "1.4.1",
  "private": true,
  "description": "Pulizia della formattazione, conversione Markdown ed esportazione PDF locale.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.cjs .\"",
    "start": "node scripts/run-electron.cjs .",
    "build": "vite build",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/run-electron.cjs tests/electron-smoke.cjs",
    "dist": "npm run build && node scripts/build-installer.cjs"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "electron-updater": "^6.8.11",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.2.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "it.testochiaro.desktop",
    "productName": "Wol Edit Text",
    "artifactName": "Wol-Edit-Text-${version}-${os}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "packages"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "licenses/**/*",
      "PRIVACY.md",
      "ACCESSIBILITY.md",
      "THIRD_PARTY_NOTICES.md",
      "SIGNING.md",
      "certificates/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wol Edit Text",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WolCarlos",
        "repo": "testo-chiaro",
        "releaseType": "release"
      }
    ]
  }
}
